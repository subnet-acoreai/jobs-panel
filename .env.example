# Optional. Official JSON API key from https://cryptojobslist.com/api-access
# Without it, the site uses the public RSS feeds at api.cryptojobslist.com/rss/*.xml
CJL_API_KEY=

# Admin inbox login (defaults shown). Only this account can view /applications.
ADMIN_EMAIL=admin@cryptojobslist.local
ADMIN_PASSWORD=admin123

# Telegram visit alerts. Create a bot with @BotFather, add it as an admin of your channel,
# then put the bot token and channel chat id here (channels are often -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
